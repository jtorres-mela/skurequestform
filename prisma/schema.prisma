// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

/* ----------------------------
   Enums (new)
   ---------------------------- */
enum RequestType {
  OPEN_STOCK
  INCREMENTAL_PROMO
  COUPON_PROMO
}

enum PromotionKind {
  INCREMENTAL_PROMO
  COUPON_PROMO
}

/* ----------------------------
   Requests (parent “work item”)
   ---------------------------- */
model Request {
  id             Int          @id @default(autoincrement())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  requesterName  String?
  requesterEmail String?
  dueDate        DateTime?
  adoId          String?      // Azure DevOps Work Request number (optional)
  userStory      String?      // ADO User Story number (optional)
  notes          String?

  // NEW: Type of request (default keeps old data valid)
  type           RequestType  @default(OPEN_STOCK)

  // children
  submissions    Submission[]
  promoUploads   PromotionUpload[]   // NEW

  @@index([createdAt])
  @@index([type])                    // helpful for filtering by type
}

/* ----------------------------
   Submissions (group of SKUs)
   (unchanged)
   ---------------------------- */
model Submission {
  id        Int       @id @default(autoincrement())
  requester String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // optional parent Request
  requestId Int?
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // children
  products  SubmissionProduct[]

  @@index([createdAt])
  @@index([requestId])
}

/* ---------------------------------
   Individual SKU row in a submission
   --------------------------------- */
model SubmissionProduct {
  id                    Int       @id @default(autoincrement())
  submissionId          Int

  // Versioning
  sku                   String
  version               Int       @default(1)
  isCurrent             Boolean   @default(true)

  // Core
  productName           String
  shortDescription      String?
  longDescription       String?

  // Marketing flags / dropdowns
  stamp                 String?
  offSaleMessage        String?

  // PDP
  isPdpRequested        Boolean   @default(false)
  pdpWorkRequest        String?

  // Translations gate & requested cultures (checkboxes)
  includeTranslations   Boolean   @default(false)
  requestedCulturesJson Json?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Smartling job tracking
  smartlingJobUids      Json?

  // relations
  submission            Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  accessories           SubmissionProductAccessory[]
  cultures              SubmissionProductCulture[]
  recommendations       SubmissionProductRecommendation[]
  markets               SubmissionProductMarket[]   // <— NEW

  @@index([submissionId])
  @@index([sku])
  @@unique([submissionId, sku, version])
}

enum Market {
  US
  CA
  MX
  GB
  IE
  NL
  DE
  PL
  LT
}

model SubmissionProductMarket {
  id          Int               @id @default(autoincrement())
  productId   Int
  market      Market
  noSavings   Boolean           @default(false)
  savings     Decimal?          
  currency    String?           
  uomValue    String?
  uomTitle    String?
  onSaleDate  DateTime?
  offSaleDate DateTime?
  noEndDate   Boolean           @default(false)

  product     SubmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, market])
  @@index([productId])
  @@index([market])
  @@index([onSaleDate])
  @@index([offSaleDate])
}


model SubmissionProductRecommendation {
  id        Int               @id @default(autoincrement())
  productId Int
  recommendedSku String?

  product   SubmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SubmissionProductAccessory {
  id             Int               @id @default(autoincrement())
  productId      Int
  accessorySku   String?
  accessoryLabel String?

  product        SubmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SubmissionProductCulture {
  id              Int               @id @default(autoincrement())
  productId       Int
  cultureCode     String            // e.g., "en-US", "en-CA"
  translatedName  String?
  translatedShort String?
  translatedLong  String?

  product         SubmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, cultureCode])
  @@index([cultureCode])
  @@index([productId])
}

/* ----------------------------
   Promotion uploads
   ---------------------------- */
model PromotionUpload {
  id          Int            @id @default(autoincrement())
  requestId   Int
  kind        PromotionKind
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  uploadedAt  DateTime       @default(now())

   lines       PromotionLine[]

  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([kind])
  @@index([uploadedAt])
}

/* ----------------------------
   Promotion line items
   ---------------------------- */
model PromotionLine {
  id              Int            @id @default(autoincrement())
  uploadId        Int
  type            PromotionKind  // INCREMENTAL_PROMO | COUPON_PROMO
  sku             String
  culture         String

  // Localized text from the sheet (per-culture rows)
  productName     String?
  shortDescription String?

  // Coupon-only fields (keep as String for flexibility; you can switch to Decimal later)
  savingsAmount   String?        // or Decimal? if you want strict numeric
  couponCode      String?

  // New free-form fields you wanted to keep as-is
  quantityRaw     String?        // e.g. "2", "1-2", "3+1"
  configurable    String?        // e.g. FSKU id
  bomRaw          String?        // e.g. "3 x F590(42994, ...); 1 x F1301(...); ..."

  // Useful for traceability back to the spreadsheet row
  uploadedRow     Int?

  createdAt       DateTime       @default(now())

  // relation
upload            PromotionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([sku])
  @@index([culture])
  @@index([type])
}